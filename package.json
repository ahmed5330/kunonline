{
  "name": "konline-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kunonline-preview --remote --file=./schema.sql",
    "db:init-local": "wrangler d1 execute kunonline-preview --local --file=./schema.sql",
    "db:commerce": "wrangler d1 execute kunonline-preview --remote --file=./migration_2026-08-23_commerce_os.sql",
    "db:commerce-local": "wrangler d1 execute kunonline-preview --local --file=./migration_2026-08-23_commerce_os.sql",
    "db:preview:setup": "npm run db:init && npm run db:commerce"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
